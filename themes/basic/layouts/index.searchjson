{{- $pages := slice -}}
{{- range where .Site.Pages "IsPage" true -}}
  {{- $pages = $pages | append (dict
    "title" .Title
    "url" .RelPermalink
    "category" (.Params.category)
    "description" (.Params.description)
    "date" (.Date.Format "2006-01-02")
    "content" (.Content)
  ) -}}
{{- end -}}
{{- $pages | jsonify -}}
